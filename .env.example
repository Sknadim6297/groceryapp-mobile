# Live production host
EXPO_PUBLIC_API_BASE_URL=https://api.supertrading.online

# Live catalogue company for GET /api/values/products?company={company}
EXPO_PUBLIC_PRODUCTS_COMPANY=8787888888

# Demo commerce UI (orders/checkout/coupons/stores). Keep off for live.
EXPO_PUBLIC_UI_PREVIEW=off

# Local fake OTP (blocks live send-otp/verify-otp). Keep off for live SMS OTP.
EXPO_PUBLIC_DEV_OTP=off

# Cashfree client environment for the native SDK only (sandbox | production).
# Never put Cashfree Secret Key / Client Secret in Expo public env — create & verify stay on the backend.
EXPO_PUBLIC_CASHFREE_ENV=sandbox

# --- Google Maps (required for delivery map + Places search) ---
# 1) Create a Google Cloud project + enable billing
# 2) Enable APIs: Maps SDK for Android, Maps SDK for iOS, Maps JavaScript API,
#    Geocoding API, Places API (New)
# 3) Create keys (best practice = separate restricted keys; one shared key works for first setup)
#
# Client key used by web map + Geocoding + Places Autocomplete in JS:
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
#
# Native SDK keys (optional if the public key above is unrestricted during bootstrap).
# Restrict these in Cloud Console to your app package / bundle + SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
