{
  "expo": {
    "name": "Mayapur Bazaar",
    "slug": "GroceryApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "groceryapp",
      "mayapurbazaar"
    ],
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "ios": {
      "bundleIdentifier": "com.groceryapp.mayapurbazaar",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "amazonpay",
          "upi",
          "credpay",
          "bhim",
          "paytmmp",
          "phonepe",
          "tez",
          "navipay",
          "mobikwik",
          "myairtel",
          "popclubapp",
          "super",
          "kiwi",
          "simplypayupi",
          "whatsapp",
          "amazonpay",
          "upi",
          "credpay",
          "bhim",
          "paytmmp",
          "phonepe",
          "tez",
          "navipay",
          "mobikwik",
          "myairtel",
          "popclubapp",
          "super",
          "kiwi",
          "simplypayupi",
          "whatsapp"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.groceryapp.mayapurbazaar",
      "adaptiveIcon": {
        "backgroundColor": "#FFD633",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.READ_PHONE_STATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mayapur Bazaar uses your location only after you tap Use current location, to fill in a delivery address."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Mayapur Bazaar uses the camera only when you open Scan QR Code, to read product or offer codes.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mayapur Bazaar accesses photos only when you choose a QR image from your gallery."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFD633",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class * extends androidx.work.InputMerger { <init>(); }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": false
        }
      },
      "eas": {
        "projectId": "96b12007-8bec-47a1-b63e-1ba6605cdfad"
      }
    },
    "owner": "nadim123456"
  }
}
