# Frontend demo UI (checkout, coupons, stores, home promos, orders, etc.).
EXPO_PUBLIC_UI_PREVIEW=on
EXPO_PUBLIC_API_BASE_URL=https://api.supertrading.online
# Opt-in Development OTP (requires Metro __DEV__). Default without this flag: disabled.
EXPO_PUBLIC_DEV_OTP=off

# Live catalogue OFF for now — app uses local dummy/frontend catalogue.
# To reconnect products later, set: EXPO_PUBLIC_PRODUCTS_COMPANY=8787888888
EXPO_PUBLIC_PRODUCTS_COMPANY=8787888888
