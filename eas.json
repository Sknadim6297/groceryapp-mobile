{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "production": {
      "distribution": "store",
      "developmentClient": false,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "client-apk": {
      "distribution": "internal",
      "developmentClient": false,
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_UI_PREVIEW": "ui-preview",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.supertrading.online",
        "EXPO_PUBLIC_DEV_OTP": "off"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
